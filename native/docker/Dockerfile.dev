# Imagem de desenvolvimento nativa (arquitetura do host, sem QEMU) para
# iterar rapido durante o port: compilar e rodar os testes de logica pura
# (sem SDL2/GPIO/audio real) muito mais rapido que a emulacao arm64.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    cmake \
    make \
    nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repo
